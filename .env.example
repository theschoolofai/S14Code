# S14Code — required
# The GLC gateway this service talks to. No default; the service refuses to
# start without it.
GLC_BASE_URL=http://localhost:8111

# S14Code — optional
S13_PORT=8113
S13_A2A_GRPC_PORT=8114
S13_GATEWAY_PROVIDER=gemini
S13_DATA_DIR=~/.s13code
S13_SANDBOX_ROOT=
S14_SURFACE_MAX_TOKENS=4000
S13_MAX_WORKERS=4
S13_A2A_GRPC_ENABLED=1
S13_A2A_SIGNING_KID=s13-local